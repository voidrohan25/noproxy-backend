# ==============================================================================
# NOPROXY BACKEND — RENDER WEB SERVICE ENVIRONMENT CONFIGURATION
# ==============================================================================

# Port to bind (Render automatically injects PORT=10000)
PORT=10000
NODE_ENV=production

# Front-end origin URL for CORS headers
FRONTEND_URL=https://YOUR-FRONTEND.vercel.app

# Cryptographic secret for signing dynamic HMAC-SHA256 QR challenges
QR_SIGNING_SECRET=generate_with_openssl_rand_hex_32

# Supabase Production Database (Required in production)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Set to 'false' in production so backend uses Supabase PostgreSQL
NEXT_PUBLIC_DEMO_MODE=false

# Optional Initial Super Admin Provisioning credentials
INITIAL_ADMIN_EMAIL=admin@noproxy.edu
INITIAL_ADMIN_PASSWORD=Admin@NoProxy2026!
